# Server Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# MongoDB Configuration
# For local MongoDB service: mongodb://127.0.0.1:27017/shopeasy
# For MongoDB Atlas cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopeasy?retryWrites=true&w=majority
# If left blank, the app will automatically spin up an embedded in-memory MongoDB instance for seamless testing!
MONGODB_URI=mongodb://127.0.0.1:27017/shopeasy

# Session Secret (change to a long random secret in production)
SESSION_SECRET=shopeasy_development_super_secure_secret_key_2026
SESSION_COOKIE_SECURE=false

# Shipping Policy Settings (in paise: 200000 paise = ₹2,000)
FREE_SHIPPING_THRESHOLD_PAISE=200000
STANDARD_SHIPPING_FEE_PAISE=9900
